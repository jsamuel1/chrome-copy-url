{
  "manifest_version": 3,
  "name": "Copy Page URL",
  "version": "1.0.0",
  "description": "Copy the current tab's URL with Arc's shortcut: Cmd+Shift+C on macOS, Ctrl+Shift+C elsewhere.",
  "permissions": ["activeTab", "offscreen"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Copy page URL" },
  "commands": {
    "copy-url": {
      "suggested_key": { "default": "Ctrl+Shift+C", "mac": "Command+Shift+C" },
      "description": "Copy the current page URL"
    }
  }
}
